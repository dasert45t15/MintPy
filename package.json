{
  "name": "mintpy",
  "version": "6.0.0",
  "description": "Atmospheric Zen audio player for Windows (Native C++20/WebView2) and Android",
  "author": "Dasert (Ivan)",
  "license": "MIT",
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "test": "node --test",
    "build:native": "powershell -ExecutionPolicy Bypass -File scripts/build-cpp.ps1",
    "build:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "build:apk": "python scripts/build-android-apk.py",
    "build:all": "powershell -ExecutionPolicy Bypass -File scripts/build-all.ps1",
    "start": "powershell -ExecutionPolicy Bypass -Command \"Start-Process .\\releases\\MintPy-Native.exe\""
  }
}
