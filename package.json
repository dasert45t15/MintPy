{
  "name": "mintpy",
  "version": "5.3.8",
  "description": "Japanese-inspired desktop music player with local playback and YouTube streaming",
  "author": "MintPy",
  "license": "MIT",
  "main": "app.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/fetch-ytdlp.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "build:apk": "python scripts/build-android-apk.py",
    "check": "node scripts/check-syntax.js",
    "test": "node --test"
  },
  "build": {
    "appId": "com.mintpy.app",
    "productName": "MintPy",
    "directories": {
      "output": "releases"
    },
    "files": [
      "app.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "!assets/*-chroma.png",
      "node_modules/**/*",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/mintpy-logo.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MintPy"
    }
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "music-metadata": "11.14.0"
  }
}
